<?xml version="1.0" encoding="UTF-8"?>
<!--
  The tests of explayouts_ui that need no database and no request: the rule input and the rule templates.
  Run from the Exponential root: php vendor/bin/phpunit -c extension/explayouts_ui/phpunit.xml.dist
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         bootstrap="tests/bootstrap.php"
         colors="false"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="explayouts_ui">
            <directory suffix="Test.php">tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
